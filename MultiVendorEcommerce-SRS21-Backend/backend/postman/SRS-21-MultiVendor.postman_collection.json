{
  "info": {
    "name": "SRS-21 Multi-Vendor Marketplace API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "buyerToken", "value": "" },
    { "key": "vendorToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "vendorId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "variantId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Test Buyer\",\n  \"email\": \"buyer@example.com\",\n  \"password\": \"buyer123\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "pm.collectionVariables.set('buyerToken', data.token);", "pm.collectionVariables.set('userId', data.user.id);"] } }]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@marketplace.local\",\n  \"password\": \"admin123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Login Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"buyer@example.com\",\n  \"password\": \"buyer123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('buyerToken', pm.response.json().token);", "pm.collectionVariables.set('userId', pm.response.json().user.id);"] } }]
        }
      ]
    },
    {
      "name": "02 Vendor Onboarding",
      "item": [
        {
          "name": "Register Vendor Application",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"businessName\": \"Kaavya Electronics\",\n  \"businessType\": \"PROPRIETORSHIP\",\n  \"phone\": \"9876543210\",\n  \"gstin\": \"22AAAAA0000A1Z5\",\n  \"pan\": \"ABCDE1234F\",\n  \"storeName\": \"Kaavya Electronics Store\",\n  \"storeDescription\": \"Consumer electronics store\",\n  \"returnPolicy\": \"15 days\"\n}" },
            "url": "{{baseUrl}}/vendors/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('vendorId', pm.response.json().id);"] } }]
        },
        {
          "name": "Admin List Vendors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/vendors"
          }
        },
        {
          "name": "Admin Approve Vendor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/vendors/{{vendorId}}/approve"
          }
        },
        {
          "name": "Login Vendor After Approval",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"buyer@example.com\",\n  \"password\": \"buyer123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('vendorToken', pm.response.json().token);"] } }]
        }
      ]
    },
    {
      "name": "03 Catalog",
      "item": [
        {
          "name": "List Categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories" },
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.length) pm.collectionVariables.set('categoryId', data[0].id);"] } }]
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Samsung Galaxy S25\",\n  \"description\": \"5G smartphone\",\n  \"brand\": \"Samsung\",\n  \"hsnCode\": \"8517\",\n  \"mrp\": 79999,\n  \"sellingPrice\": 79999,\n  \"gstRate\": 18,\n  \"categoryId\": \"{{categoryId}}\"\n}" },
            "url": "{{baseUrl}}/products"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('productId', pm.response.json().id);"] } }]
        },
        {
          "name": "Add Product Variant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"S25-BLK-256\",\n  \"size\": \"256GB\",\n  \"colour\": \"Black\",\n  \"material\": \"Glass\",\n  \"price\": 79999,\n  \"stockQuantity\": 10\n}" },
            "url": "{{baseUrl}}/products/{{productId}}/variants"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('variantId', pm.response.json().id);"] } }]
        },
        {
          "name": "Publish Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }],
            "url": "{{baseUrl}}/products/{{productId}}/publish"
          }
        },
        {
          "name": "Search Products",
          "request": { "method": "GET", "url": "{{baseUrl}}/products?search=Samsung" }
        }
      ]
    },
    {
      "name": "04 Buyer Checkout",
      "item": [
        {
          "name": "Add To Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "View Cart",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }], "url": "{{baseUrl}}/cart" }
        },
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"shippingAddress\": \"Coimbatore, Tamil Nadu, India\",\n  \"paymentMethod\": \"UPI\"\n}" },
            "url": "{{baseUrl}}/orders/checkout"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('orderId', pm.response.json().id);"] } }]
        },
        {
          "name": "Capture Mock Payment",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }], "url": "{{baseUrl}}/payments/capture/{{orderId}}" }
        },
        {
          "name": "My Orders",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }], "url": "{{baseUrl}}/orders" }
        }
      ]
    }
  ]
}
